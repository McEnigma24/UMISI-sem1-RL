#!/bin/bash
#SBATCH --job-name=DT_ckpt
#SBATCH --account=plglscclass26-gpu
#SBATCH --partition=plgrid-gpu-v100
#SBATCH --time=03:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=24G
#SBATCH --gres=gpu:1
#SBATCH --output=GRID_log_out_%j.txt
#SBATCH --error=GRID_log_err_%j.txt

# Pipeline checkpoint -> DT -> porownanie dla JEDNEJ aktywnosci.
# Parametry przez zmienne srodowiskowe (sbatch --export):
#   CKPT_ENV    = FetchSlide-v4 | FetchPush-v4 | FetchPickAndPlace-v4   (wymagane)
#   CKPT_STEPS  = np. 800000                                            (wymagane)
#   N_EPISODES  = liczba epizodow do nagrania (domyslnie 1800)
#   MAX_ITERS   = iteracje treningu DT (domyslnie 40000)
#   EVAL_EP     = epizody ewaluacji (domyslnie 50)

cd $SLURM_SUBMIT_DIR
ls -al

# Workery DataLoadera dziela tensory przez deskryptory plikow (HDF5 Minari) ->
# domyslny limit wyczerpuje sie ~iter 5000 ("Too many open files"). Podnosimy go;
# w kodzie dodatkowo ustawiamy sharing_strategy='file_system'.
ulimit -n 65536 2>/dev/null || ulimit -n 16384 2>/dev/null || true
echo "ulimit -n = $(ulimit -n)"

module load python/3.12.3-gcccore-13.3.0
module load cuda

pelna_sciezka=$(realpath .)
output="${pelna_sciezka#/net/people/plgrid/plgwmackowiak/}"

scratch_activation_path="$SCRATCH/$output/.venv/bin/activate"
echo "SOURCING -> $scratch_activation_path"

source $scratch_activation_path

: "${CKPT_ENV:?Ustaw CKPT_ENV, np. --export=ALL,CKPT_ENV=FetchSlide-v4,CKPT_STEPS=800000}"
: "${CKPT_STEPS:?Ustaw CKPT_STEPS, np. 800000}"
N_EPISODES="${N_EPISODES:-1800}"
MAX_ITERS="${MAX_ITERS:-40000}"
EVAL_EP="${EVAL_EP:-50}"
# EVAL_ONLY=1  -> tylko ponowna ewaluacja (record/train pomijane); przydatne
#                do zwiekszenia liczby epizodow bez retreningu.
# FORCE_EVAL=1 -> przelicz eval nawet gdy eval_metrics.json juz istnieje (nadpisze).
EVAL_ONLY="${EVAL_ONLY:-0}"
FORCE_EVAL="${FORCE_EVAL:-0}"

STAGES="record,train,eval,plot"
if [ "$EVAL_ONLY" = "1" ]; then
  STAGES="eval,plot"
fi

EXTRA_FLAGS=()
if [ "$FORCE_EVAL" = "1" ]; then
  EXTRA_FLAGS+=(--force-eval --force-plot)
fi

echo "=== DT ckpt pipeline: $CKPT_ENV @ $CKPT_STEPS (ep=$N_EPISODES iters=$MAX_ITERS eval_ep=$EVAL_EP stages=$STAGES) ==="
nvidia-smi || true
python -c "import torch; print('cuda?', torch.cuda.is_available())"

python run_ckpt_pipeline.py \
  --env "$CKPT_ENV" \
  --checkpoint-steps "$CKPT_STEPS" \
  --device cuda \
  --n-episodes "$N_EPISODES" \
  --max-iters "$MAX_ITERS" \
  --eval-episodes "$EVAL_EP" \
  --stages "$STAGES" \
  "${EXTRA_FLAGS[@]}"

echo "Koniec zadania ($CKPT_ENV @ $CKPT_STEPS)."
